# Copia estos nombres en Vercel → Project → Settings → Environment Variables.
# Nunca subas los valores reales al repositorio ni los pongas en el navegador.

# Supabase (los datos viven aquí; la clave publicable es apta para el servidor)
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ALTCHA: secreto HMAC que firma los retos del captcha de registro.
# Cadena aleatoria de 32+ caracteres (por ejemplo: openssl rand -hex 32).
# Si falta, el registro en la nube responde 503 en lugar de aceptar cuentas sin captcha.
ALTCHA_HMAC_SECRET=

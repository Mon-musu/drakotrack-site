# Copia estos nombres en Vercel → Project → Settings → Environment Variables.
# Nunca subas los valores reales al repositorio ni los pongas en el navegador.

# Supabase (los datos viven aquí; la clave publicable es apta para el servidor)
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

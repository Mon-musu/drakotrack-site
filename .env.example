# Copia estos nombres en Vercel → Project → Settings → Environment Variables.
# Nunca subas los valores reales al repositorio ni los pongas en el navegador.

# Supabase (los datos viven aquí; la clave publicable es apta para el servidor)
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Opcional pero recomendada en producción: clave secreta de servidor, solo para
# el rate limiting compartido entre instancias (RPC rate_limit_hit). Nunca se
# envía al navegador. Sin ella los límites se aplican por instancia.
SUPABASE_SECRET_KEY=sb_secret_...

node_modules/
.env
.env.*
!.env.example

# Cloudflare build output and local Wrangler state
dist/
.wrangler/
.dev.vars
*.log
test-users.json
drakotrack-deploy.zip

# APK build tree: keys and scratch output stay local, but CI needs the base
# shell and the manifest patcher, so those two are tracked.
apk-build/*
!apk-build/bump-version.py
!apk-build/shell-base.apk

# APK binaries are published as GitHub release assets; the repo keeps only the feed
apk/*.apk

# Árboles de despliegue y enlaces locales de la CLI
.deploy-stage/
.vercel/
artifacts/

# Árboles locales de despliegue y artefactos de build
deploy/
chunks/
bundle/
*.idsig
drakotrack-sync.bundle

# Token local para publicar (nunca se versiona)
vercel-token.txt

# Entregas ZIP y carpetas de herramientas del asistente: no son código del
# producto y no deben llegar al repositorio ni al build de Cloudflare
drakotrack-codigo-*.zip
.agents/
.claude/
agent/
.mcp.json
skills-lock.json
